# 本机运行配置（已被 .gitignore 排除）
# 等你提供新的 API Key 后填入下面的空位即可。
#
# ⚠️ **两个端点、两个文件**（用户 2026-09-19 裁定）：
#   · 本文件 `.env`     —— **真实记忆库聊天**（手动打开并与她对话）用的**原 key**
#   · `.env.test`       —— **执行测试**（全量回归 / 冒烟 / 评测）用的测试端点
#                          见 `.env.test.example`；用 `pnpm with-test-model <命令>` 跑
#   · 并行跑测试而不碰真实额度：测试一律走 `.env.test`
#   · 默认**没有预算上限**（仓库没有花费计量机制，也不假装有）

# ---------- 对话模型：DeepSeek 官方端点 ----------
# ⚠️ 官方端点实际提供的是 `deepseek-flash` / `deepseek-v4-pro`；
#    `deepseek-v4.1-flash` 在**官方端点**上会被拒（那是**测试端点**上的名字）。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_LARGE_MODEL=deepseek-flash
OPENAI_SMALL_MODEL=deepseek-flash

# ---------- Embedding（可选）----------
# DeepSeek 官方不提供 embedding 端点，所以这里单独配置；
# L1-M1 用不到向量召回，留空也不影响运行（仅会看到一条 embedding 警告）。
OPENAI_EMBEDDING_URL=
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_EMBEDDING_DIMENSIONS=1024

# ---------- 数据库 ----------
PGLITE_DATA_DIR=./data/pglite

# ---------- 运行 ----------
LOG_LEVEL=info
USER_NAME=Alex
CONVERSATION_LENGTH=16
DEBUG_CONTEXT=1

# ---------- Lv2.5 世界线（可选，普通聊天默认不加载）----------
CHARACTER_STORY_COGNITION_ENABLED=false
CHARACTER_STORY_CHOICE_DECISION_ENABLED=false
CHARACTER_STORY_DAILY_ENABLED=false
CHARACTER_STORY_CHOICE_DECISION_TIMEOUT_MS=8000
