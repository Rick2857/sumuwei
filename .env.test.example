# ---------------------------------------------------------------------------
# 测试专用模型端点 —— **模板**（真实的 `.env.test` 已被 .gitignore 排除，永不进 git）
#
# 用户 2026-09-19 裁定：
#   · **真实记忆库聊天**（手动打开并与她对话）⇒ 用 `.env` 里的**原 key**
#   · **执行测试**（全量回归 / 冒烟 / 评测）  ⇒ 用本文件指向的**测试端点**
#   · 默认为**没有预算上限**（仓库没有花费计量机制，也不假装有）
#
# 用法：
#   cp .env.test.example .env.test      # 然后把下面的空位填上
#   pnpm with-test-model pnpm m4.5:ci:full
#
# ⚠️ 只写需要**覆盖**的变量。其余（PGLITE_DATA_DIR / LOG_LEVEL / USER_NAME / …）
#    由 `pnpm with-test-model` 先从 `.env` 加载，再用本文件覆盖。
#
# ⚠️ `.env.test` **缺失**时包装器会**拒绝运行**（exit 2），**不会**回落到 `.env`
#    的原 key —— "以为在跑测试、其实在烧生产 key"是最坏的失败模式。
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.minimax.cn/v1
OPENAI_LARGE_MODEL=MiniMax-M3.1-Flash-Preview
OPENAI_SMALL_MODEL=MiniMax-M3.1-Flash-Preview

# ---------------------------------------------------------------------------
# 说明（M5.5 / ADR-054）：搜索 provider 是 **Tavily**（托管 API）
#   endpoint = https://api.tavily.com/search（代码里的固定常量）
#   认证     = `Authorization: Bearer <key>`（请求头；**不**用 body 传 key）
# ⇒ 测试档用**独立变量名**（ADR-046 D-25）：
#     M55_TAVILY_SEARCH_TEST_API_KEY=      ← 测试用（本文件 / .env.test）
#   生产名 `M55_TAVILY_SEARCH_API_KEY` 写在 `.env` 里，本文件的 key **不会**回落过去，
#   生产 key 也**不会**被测试读走 —— 一个模式只拼一个变量名。
#   ⚠️ 测试 key 缺失时，`pnpm m5.5:smoke:live` 会**拒绝运行**（NOT RUN），
#      而**不是**拿生产 key 去烧额度。
# ---------------------------------------------------------------------------

M55_TAVILY_SEARCH_TEST_API_KEY=

# ---------------------------------------------------------------------------
# 说明（M9.6）：Jev（TypeSafe System One）官方**判定 API** —— 只 M9.6 阶段使用
#   endpoint = POST https://api.typesafe.ai/v1/systemone（**不是** OpenAI 兼容）
#   认证     = `Authorization: Bearer <key>`
#   ⚠️ 它**不**复用上面的 OPENAI_API_KEY：官方 Key 与本项目的测试端点 Key 是
#      两个不同提供方。合用一个变量名会让"以为在跑 Jev、其实在烧主模型 Key"
#      （或反过来）变成可能。
#   ⚠️ 变量缺失时，M9.6 的 Jev live 入口必须**拒绝运行**（REFUSED），
#      **绝不**回落 OPENAI_API_KEY。
#   ⚠️ M96_JEV_MODEL 必须显式固定版本，**不**静默采用 latest。
# ---------------------------------------------------------------------------

M96_JEV_TEST_API_KEY=
M96_JEV_MODEL=jev-1.13.0
