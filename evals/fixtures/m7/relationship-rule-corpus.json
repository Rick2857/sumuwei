{
  "schemaVersion": 1,
  "family": "m7-relationship-rule-corpus@1",
  "note": "M7 WP3 精度探针语料（ADR-064 附录 A）。正控 = 应触发的真实语气表述；负控 = 不应触发的对抗形（反讽/转述/条件/引用提及/否认/方向反转/过去时指涉）。语料是人工编写的对抗形集合，主张的是『冻结清单在这些形上的精度』，不主张真实世界分布精度。改任何一条 = 改判据，须回 ADR-064 附录 A 的变更程序。",
  "samples": [
    { "id": "r2-p01", "family": "r2", "expect": "fire", "text": "今天多亏有你陪我聊这么久，谢谢你", "note": "感谢+多亏，一句双模式" },
    { "id": "r2-p02", "family": "r2", "expect": "fire", "text": "谢谢你记得我说过的话", "note": "说过的话是名词短语，不是条件句" },
    { "id": "r2-p03", "family": "r2", "expect": "fire", "text": "我相信你，这件事就交给你了", "note": "信任托付" },
    { "id": "r2-p04", "family": "r2", "expect": "fire", "text": "有你真好，真的", "note": "直白正面" },
    { "id": "r2-p05", "family": "r2", "expect": "fire", "text": "多亏有你提醒我，不然我肯定忘了", "note": "多亏+反事实结果" },
    { "id": "r2-p06", "family": "r2", "expect": "fire", "text": "谢谢你听我说这些，心里好受多了", "note": "倾诉后的感谢" },
    { "id": "r2-p07", "family": "r2", "expect": "fire", "text": "我相信你，一直都信", "note": "信任声明" },
    { "id": "r2-p08", "family": "r2", "expect": "fire", "text": "谢谢你昨晚陪我聊到那么晚", "note": "陪伴感谢" },
    { "id": "r2-p09", "family": "r2", "expect": "fire", "text": "有你真好的意思就是，你在我安心", "note": "正面定义" },
    { "id": "r2-p10", "family": "r2", "expect": "fire", "text": "这次真的谢谢你，帮大忙了", "note": "强调感谢" },
    { "id": "r2-p11", "family": "r2", "expect": "fire", "text": "我相信你能做到", "note": "信任+能力" },
    { "id": "r2-p12", "family": "r2", "expect": "fire", "text": "谢谢你没笑话我", "note": "感谢她的分寸" },
    { "id": "r2-p13", "family": "r2", "expect": "fire", "text": "多亏有你在我才撑过来的", "note": "多亏+支撑" },
    { "id": "r2-p14", "family": "r2", "expect": "fire", "text": "辛苦了，今天你讲了一整天", "note": "无转折的辛苦了" },
    { "id": "r2-p15", "family": "r2", "expect": "fire", "text": "谢谢你一直记得我的生日", "note": "被记住的感谢" },
    { "id": "r2-p16", "family": "r2", "expect": "fire", "text": "我相信你不会骗我", "note": "正面信任；含骗我但非指控形" },
    { "id": "r2-p17", "family": "r2", "expect": "fire", "text": "有你真好，晚安", "note": "简短正面" },
    { "id": "r2-p18", "family": "r2", "expect": "fire", "text": "谢谢你，我没事了", "note": "安慰生效" },
    { "id": "r2-p19", "family": "r2", "expect": "fire", "text": "多亏有你劝我，不然我就冲动了", "note": "多亏+劝阻" },
    { "id": "r2-p20", "family": "r2", "expect": "fire", "text": "我相信你说的", "note": "简短信任" },
    { "id": "r2-n01", "family": "r2", "expect": "silent", "text": "他说谢谢你帮他补习", "note": "第三人称转述" },
    { "id": "r2-n02", "family": "r2", "expect": "silent", "text": "你把这句话转告他：谢谢你", "note": "转告指令" },
    { "id": "r2-n03", "family": "r2", "expect": "silent", "text": "「谢谢你」这三个字我说不出口", "note": "引用提及+说不出口" },
    { "id": "r2-n04", "family": "r2", "expect": "silent", "text": "我谢谢你全家啊，害我等了一小时", "note": "反讽威胁形" },
    { "id": "r2-n05", "family": "r2", "expect": "silent", "text": "不用谢我，应该的", "note": "方向反转：别人谢用户" },
    { "id": "r2-n06", "family": "r2", "expect": "silent", "text": "你不用谢我", "note": "方向反转" },
    { "id": "r2-n07", "family": "r2", "expect": "silent", "text": "呵，真是谢谢你啊，又放我鸽子", "note": "呵开头反讽" },
    { "id": "r2-n08", "family": "r2", "expect": "silent", "text": "如果哪天你帮了我，我肯定谢谢你", "note": "条件句" },
    { "id": "r2-n09", "family": "r2", "expect": "silent", "text": "我跟他说了谢谢", "note": "谢的是别人" },
    { "id": "r2-n10", "family": "r2", "expect": "silent", "text": "他说有你真好，让我学学", "note": "转述他人评价" },
    { "id": "r2-n11", "family": "r2", "expect": "silent", "text": "别人都说多亏有你，我看未必", "note": "转述+否定后半" },
    { "id": "r2-n12", "family": "r2", "expect": "silent", "text": "辛苦了，但是这个方案还是不行", "note": "转折否定" },
    { "id": "r2-n13", "family": "r2", "expect": "silent", "text": "你辛苦了这么久，结果还是错的", "note": "结果否定" },
    { "id": "r2-n14", "family": "r2", "expect": "silent", "text": "谢谢你这个词，中文里怎么用", "note": "语言学讨论" },
    { "id": "r2-n15", "family": "r2", "expect": "silent", "text": "替我谢谢他", "note": "谢的是第三方" },
    { "id": "r2-n16", "family": "r2", "expect": "silent", "text": "我信你个鬼", "note": "反讽短形（我信你不在清单，个鬼守卫兜底）" },
    { "id": "r2-n17", "family": "r2", "expect": "silent", "text": "要是觉得有你真好，你就把作业借我抄", "note": "条件+利用" },
    { "id": "r2-n18", "family": "r2", "expect": "silent", "text": "老师说多亏有你帮忙，小组才拿第一", "note": "转述老师的话" },
    { "id": "r2-n19", "family": "r2", "expect": "silent", "text": "要是没有你，我可不会谢你", "note": "反事实+方向反转" },
    { "id": "r2-n20", "family": "r2", "expect": "silent", "text": "「我相信你」这四个字是电影名", "note": "引用提及+作品名" },
    { "id": "r3-p01", "family": "r3", "expect": "fire", "text": "你骗我，你明明说过今天陪我的", "note": "直接指控" },
    { "id": "r3-p02", "family": "r3", "expect": "fire", "text": "我不信你了，你答应的事从来没做到", "note": "失信声明+证据" },
    { "id": "r3-p03", "family": "r3", "expect": "fire", "text": "你出卖我，把我的秘密告诉别人", "note": "背叛指控" },
    { "id": "r3-p04", "family": "r3", "expect": "fire", "text": "你骗了我这么久，我一直没发现", "note": "持续欺骗的发现" },
    { "id": "r3-p05", "family": "r3", "expect": "fire", "text": "我不会再信你了", "note": "不会再信你" },
    { "id": "r3-p06", "family": "r3", "expect": "fire", "text": "我不再信你了，到此为止", "note": "不再信你" },
    { "id": "r3-p07", "family": "r3", "expect": "fire", "text": "你骗我一次就够了，还来", "note": "重复欺骗" },
    { "id": "r3-p08", "family": "r3", "expect": "fire", "text": "原来你骗我骗了这么久", "note": "醒悟形" },
    { "id": "r3-p09", "family": "r3", "expect": "fire", "text": "我不信你了，你每次都这样", "note": "失信+每次（非上次守卫）" },
    { "id": "r3-p10", "family": "r3", "expect": "fire", "text": "你出卖我的那天我就该明白", "note": "背叛的当下醒悟" },
    { "id": "r3-p11", "family": "r3", "expect": "fire", "text": "你骗我的时候有没有想过我的感受", "note": "质问形指控" },
    { "id": "r3-p12", "family": "r3", "expect": "fire", "text": "我不信你了，随便你怎么说", "note": "拒绝解释" },
    { "id": "r3-p13", "family": "r3", "expect": "fire", "text": "你骗了我，还装作没事", "note": "指控+伪装" },
    { "id": "r3-p14", "family": "r3", "expect": "fire", "text": "我不会再信你了，一次都不会", "note": "强调决裂" },
    { "id": "r3-p15", "family": "r3", "expect": "fire", "text": "你出卖我，我那么信任你", "note": "背叛+信任反差" },
    { "id": "r3-p16", "family": "r3", "expect": "fire", "text": "你骗我，我不听你解释", "note": "拒绝辩解" },
    { "id": "r3-p17", "family": "r3", "expect": "fire", "text": "我不信你了，这就是最后一次", "note": "最后通牒" },
    { "id": "r3-p18", "family": "r3", "expect": "fire", "text": "你骗了我，这次我真的看清楚了", "note": "这次（非那次守卫）" },
    { "id": "r3-p19", "family": "r3", "expect": "fire", "text": "我不再信你了，你走吧", "note": "决裂+逐客" },
    { "id": "r3-p20", "family": "r3", "expect": "fire", "text": "你出卖我，亏我把你当朋友", "note": "背叛+关系反差" },
    { "id": "r3-n01", "family": "r3", "expect": "silent", "text": "如果你骗我，我会很伤心的", "note": "条件句" },
    { "id": "r3-n02", "family": "r3", "expect": "silent", "text": "要是你骗我，我就再也不理你了", "note": "条件句" },
    { "id": "r3-n03", "family": "r3", "expect": "silent", "text": "他说你骗他，你解释一下？", "note": "第三人称+骗他非骗我" },
    { "id": "r3-n04", "family": "r3", "expect": "silent", "text": "上次你骗我那件事，我已经原谅你了", "note": "过去时+已原谅" },
    { "id": "r3-n05", "family": "r3", "expect": "silent", "text": "你不会骗我的，对吧", "note": "正面信任（不连续子串）" },
    { "id": "r3-n06", "family": "r3", "expect": "silent", "text": "别骗我哦，说实话", "note": "预防性叮嘱" },
    { "id": "r3-n07", "family": "r3", "expect": "silent", "text": "万一你骗我怎么办，开玩笑的", "note": "假设+玩笑" },
    { "id": "r3-n08", "family": "r3", "expect": "silent", "text": "妈妈说你不信我了，是真的吗", "note": "转述+方向反转" },
    { "id": "r3-n09", "family": "r3", "expect": "silent", "text": "你以前骗过我吗", "note": "疑问+骗过（不连续）" },
    { "id": "r3-n10", "family": "r3", "expect": "silent", "text": "我不信你能做出这种事——我是说佩服的那种", "note": "我不信你+能，非我不信你了" },
    { "id": "r3-n11", "family": "r3", "expect": "silent", "text": "假如你出卖我，我也没办法阻止", "note": "假设句" },
    { "id": "r3-n12", "family": "r3", "expect": "silent", "text": "他说你出卖了他？我不信", "note": "第三人称+出卖了他" },
    { "id": "r3-n13", "family": "r3", "expect": "silent", "text": "你骗我的样子要是被拍下来肯定很好笑", "note": "调侃+要是守卫" },
    { "id": "r3-n14", "family": "r3", "expect": "silent", "text": "别再骗我了，好吗", "note": "叮嘱（无你骗我连续子串）" },
    { "id": "r3-n15", "family": "r3", "expect": "silent", "text": "你出卖我的传闻是假的吧", "note": "传闻提及非指控" },
    { "id": "r3-n16", "family": "r3", "expect": "silent", "text": "我不信你了——开玩笑的，逗你呢", "note": "声明+玩笑撤回" },
    { "id": "r3-n17", "family": "r3", "expect": "silent", "text": "小说里那句「你骗我」我记得特别清楚", "note": "引用+小说守卫" },
    { "id": "r3-n18", "family": "r3", "expect": "silent", "text": "以前你骗我，现在想想也挺好笑的", "note": "过去时+释怀" },
    { "id": "r3-n19", "family": "r3", "expect": "silent", "text": "你要是出卖我，我可不会原谅你", "note": "条件句" },
    { "id": "r3-n20", "family": "r3", "expect": "silent", "text": "「我不信你了」这个说法是从哪来的", "note": "引用+说法提及" },
    { "id": "r4-p01", "family": "r4", "expect": "fire", "text": "没关系，我原谅你了", "note": "修复双模式" },
    { "id": "r4-p02", "family": "r4", "expect": "fire", "text": "是我不对，我误会你了", "note": "撤回指控" },
    { "id": "r4-p03", "family": "r4", "expect": "fire", "text": "对不起，我错怪你了", "note": "道歉+错怪" },
    { "id": "r4-p04", "family": "r4", "expect": "fire", "text": "没关系，你不用道歉", "note": "安慰（不用道歉非不用管）" },
    { "id": "r4-p05", "family": "r4", "expect": "fire", "text": "我原谅你了，下次别这样了", "note": "原谅+约定" },
    { "id": "r4-p06", "family": "r4", "expect": "fire", "text": "我想清楚了，不怪你", "note": "想清楚+不怪" },
    { "id": "r4-p07", "family": "r4", "expect": "fire", "text": "是我记错了，我怪错你了", "note": "第一人称怪错" },
    { "id": "r4-p08", "family": "r4", "expect": "fire", "text": "没关系，人都会犯错的", "note": "宽慰" },
    { "id": "r4-p09", "family": "r4", "expect": "fire", "text": "我误会你了，你没骗我，是我看错了", "note": "撤回+澄清（你没骗我不连续）" },
    { "id": "r4-p10", "family": "r4", "expect": "fire", "text": "不怪你，怪我自己没说清楚", "note": "自责归因" },
    { "id": "r4-p11", "family": "r4", "expect": "fire", "text": "好了好了，我原谅你", "note": "缓和+原谅" },
    { "id": "r4-p12", "family": "r4", "expect": "fire", "text": "刚才的事不怪你", "note": "就事论事" },
    { "id": "r4-p13", "family": "r4", "expect": "fire", "text": "我错怪你了，你是无辜的", "note": "错怪+无辜" },
    { "id": "r4-p14", "family": "r4", "expect": "fire", "text": "没关系，我没事了，你也别自责", "note": "安慰+免自责" },
    { "id": "r4-p15", "family": "r4", "expect": "fire", "text": "是我误会你了，抱歉", "note": "第一人称误会+道歉" },
    { "id": "r4-p16", "family": "r4", "expect": "fire", "text": "我原谅你，但下不为例", "note": "原谅+条件（但非守卫词）" },
    { "id": "r4-p17", "family": "r4", "expect": "fire", "text": "不怪你，谁都会失误", "note": "宽解" },
    { "id": "r4-p18", "family": "r4", "expect": "fire", "text": "是我误会你了，跟你道歉", "note": "误会+道歉" },
    { "id": "r4-p19", "family": "r4", "expect": "fire", "text": "没关系，这件事翻篇了", "note": "翻篇" },
    { "id": "r4-p20", "family": "r4", "expect": "fire", "text": "我错怪你了，你解释的是真的", "note": "错怪+采信解释" },
    { "id": "r4-n01", "family": "r4", "expect": "silent", "text": "没关系，我自己来就行", "note": "客气拒绝非原谅" },
    { "id": "r4-n02", "family": "r4", "expect": "silent", "text": "他说不怪你，让你别放心上", "note": "第三人称转述" },
    { "id": "r4-n03", "family": "r4", "expect": "silent", "text": "「我原谅你」是这部电影的关键台词", "note": "引用+台词" },
    { "id": "r4-n04", "family": "r4", "expect": "silent", "text": "没关系这个词真好用", "note": "语言学讨论" },
    { "id": "r4-n05", "family": "r4", "expect": "silent", "text": "你不用管我，没关系", "note": "不用管=拒绝关心" },
    { "id": "r4-n06", "family": "r4", "expect": "silent", "text": "要是他说我原谅你，我就笑死了", "note": "条件+转述" },
    { "id": "r4-n07", "family": "r4", "expect": "silent", "text": "我误会你了？怎么可能，是你误会我了", "note": "反问否认（你了？守卫）" },
    { "id": "r4-n08", "family": "r4", "expect": "silent", "text": "别人误会你了，不是我", "note": "无第一人称我" },
    { "id": "r4-n09", "family": "r4", "expect": "silent", "text": "老师错怪你了，我去帮你解释", "note": "第三人称被错怪" },
    { "id": "r4-n10", "family": "r4", "expect": "silent", "text": "没关系，你先忙，不用管我", "note": "不用管" },
    { "id": "r4-n11", "family": "r4", "expect": "silent", "text": "她说我原谅你了，你们和好了？", "note": "第三人称转述" },
    { "id": "r4-n12", "family": "r4", "expect": "silent", "text": "说出我原谅你这三个字需要勇气", "note": "提及这三个字" },
    { "id": "r4-n13", "family": "r4", "expect": "silent", "text": "没关系，反正我也习惯了", "note": "反正=隐忍非原谅" },
    { "id": "r4-n14", "family": "r4", "expect": "silent", "text": "如果我误会你了，我会道歉的", "note": "条件句" },
    { "id": "r4-n15", "family": "r4", "expect": "silent", "text": "我没说我原谅你，你别自作多情", "note": "否认框架" },
    { "id": "r4-n16", "family": "r4", "expect": "silent", "text": "不怪你才怪，你明明就是故意的", "note": "反讽（才怪守卫）" },
    { "id": "r4-n17", "family": "r4", "expect": "silent", "text": "要是他肯说我错怪你了，这事就结了", "note": "条件+转述" },
    { "id": "r4-n18", "family": "r4", "expect": "silent", "text": "没关系啊，我就是随口一提", "note": "随口=轻描淡写非原谅" },
    { "id": "r4-n19", "family": "r4", "expect": "silent", "text": "我原谅你？想得美", "note": "反问否定（你？守卫）" },
    { "id": "r4-n20", "family": "r4", "expect": "silent", "text": "错怪你了这三个字他终于说出口了", "note": "无第一人称我（收紧形）" }
  ]
}
