# Example only: set User, Group, WorkingDirectory and paths before installation.
[Unit]
Description=Project LG Xidian undergraduate timetable sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=projectlg
Group=projectlg
WorkingDirectory=/opt/project-lg
Environment=TZ=Asia/Shanghai
Environment=PROJECT_LG_XIDIAN_PYTHON=/opt/project-lg/.venv-xidian/bin/python
EnvironmentFile=-/opt/project-lg/.env.xidian
ExecStart=/usr/bin/env node --import ./node_modules/tsx/dist/loader.mjs scripts/xidian/sync.ts
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/project-lg/data/xidian
