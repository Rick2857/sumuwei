# Separate private QQ owner and bot; existing USER_NAME in .env supplies the LG domain identity.
QQ_OWNER_ID=
QQ_BOT_ID=
QQ_ONEBOT_WS_URL=ws://127.0.0.1:6701/
QQ_ONEBOT_ACCESS_TOKEN=
QQ_NAPCAT_WEBUI_TOKEN=
QQ_NAPCAT_IMAGE=

# Optional multi-user entry. Keep disabled until your database is migrated
# and your own allowed groups and bot membership have been checked.
QQ_MULTI_USER_ENABLED=false
QQ_ALLOWED_GROUP_IDS=
