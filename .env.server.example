# Server edition: copy this file to .env and configure your own deployment.
USER_NAME=Alex
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_LARGE_MODEL=deepseek-flash
OPENAI_SMALL_MODEL=deepseek-flash
CHARACTER_DB_BACKEND=postgres
POSTGRES_URL=
LG_PG_EXPECT_DATABASE=sumuwei
LG_PG_EXPECT_USER=lg_migrate
CHARACTER_KERNEL_ENABLED=true
CHARACTER_MEMORY_ENABLED=true
CHARACTER_MEMORY_EXPLICIT_ENABLED=true
# Thin host is the only runtime; requires a prepared schema and ContextCompiler.
CHARACTER_THIN_HOST=true
# Optional tools and integrations require their own dependencies and authority.
CHARACTER_EXECUTOR_ENABLED=false
CHARACTER_WEB_SEARCH_ENABLED=false
CHARACTER_TASK_AUTONOMY_ENABLED=false
CHARACTER_DESKTOP_INSPECT_ENABLED=false
CHARACTER_DESKTOP_OPERATE_ENABLED=false

# Optional QQ reply voice; configure your own TTS endpoint/key before enabling.
CHARACTER_QQ_VOICE_REPLY=false
CHARACTER_QQ_VOICE_OUTPUT=false
CHARACTER_QQ_TTS_PROTOCOL=qwen-tts
CHARACTER_QQ_TTS_URL=
CHARACTER_QQ_TTS_API_KEY=
CHARACTER_QQ_TTS_MODEL=qwen3-tts-flash
CHARACTER_QQ_TTS_VOICE=Chelsie

# Optional Xidian undergraduate timetable; no school credentials in this file.
CHARACTER_XIDIAN_TIMETABLE_ENABLED=false
# PROJECT_LG_XIDIAN_DIR=/absolute/private/path/xidian

# Experimental evidence lifecycle and bounded simulation; explicitly opt in.
CHARACTER_EPISTEMIC_BELIEF_ENABLED=false
CHARACTER_EPISTEMIC_BELIEF_HUMAN_SHADOW=false
CHARACTER_EPISTEMIC_BELIEF_HUMAN_ENABLED=false
CHARACTER_SIMULATION_PLANNER_ENABLED=false
CHARACTER_SIMULATION_PRECONDITION_RULES_ENABLED=false
