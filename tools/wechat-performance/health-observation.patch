 /// How often to run the health scan (in seconds).
 const SCAN_INTERVAL_SECS: u64 = 1;
+
+// Process crash checks stay fast; healthy UI observations need not traverse the desktop every second.
+const HEALTHY_OBSERVATION_INTERVAL_SECS: u64 = 10;
+
+fn observation_due(last: Option<Instant>, now: Instant) -> bool {
+    last.map(|at| now.duration_since(at).as_secs() >= HEALTHY_OBSERVATION_INTERVAL_SECS)
+        .unwrap_or(true)
+}
 
 /// Kill WeChat if no IA state has been identified for this long (in seconds).
 const UNRESPONSIVE_TIMEOUT_SECS: u64 = 60;
