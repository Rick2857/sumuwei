+#[cfg(test)]
+mod cadence_tests {
+    use super::*;
+    use std::time::Duration;
+
+    #[test]
+    fn first_failure_and_restart_are_immediate_but_healthy_scans_are_bounded() {
+        let now = Instant::now();
+        assert!(observation_due(None, now));
+        assert!(!observation_due(Some(now), now + Duration::from_secs(1)));
+        assert!(!observation_due(Some(now), now + Duration::from_secs(9)));
+        assert!(observation_due(Some(now), now + Duration::from_secs(10)));
+        assert!(observation_due(Some(now), now + Duration::from_secs(11)));
